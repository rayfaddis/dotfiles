#!/bin/bash

source ./ui.sh

ui_section "Configure"

################################################################################
# Confirm every dotfile is linked to its source
################################################################################
check_links() {
  local dest src count=0 broken=()
  while IFS=: read -r dest src; do
    count=$((count + 1))
    [ "$(readlink "$dest")" = "$src" ] || broken+=("${dest/#$HOME/~}")
  done < <(lsrc)
  if [ ${#broken[@]} -gt 0 ]; then
    ui_detail "${#broken[@]} of $count not linked: ${broken[*]}"
    return 1
  fi
  ui_detail "$count links"
}
ui_step "Dotfiles linked" check_links

################################################################################
# rcup never removes links it stops managing, such as files later added to
# EXCLUDES or deleted from the repo. Remove them and any folders left empty.
################################################################################
prune_links() {
  local managed link dir removed=0
  managed=$(lsrc | cut -d: -f1)
  while read -r link; do
    grep -qxF "$link" <<<"$managed" && continue
    rm "$link" || return 1
    ui_item del "${link/#$HOME/~}"
    removed=$((removed + 1))
    dir=$(dirname "$link")
    while [ "$dir" != "$HOME" ] && rmdir "$dir" 2>/dev/null; do
      dir=$(dirname "$dir")
    done
  done < <(find "$HOME" -maxdepth 4 \
    \( -name Library -o -name .Trash -o -name node_modules -o -name .git \) -prune \
    -o -type l -lname "$HOME/dotfiles/*" -print 2>/dev/null)
  if [ "$removed" -gt 0 ]; then
    ui_detail "$removed removed"
  else
    ui_detail "none stale"
  fi
}
ui_step "Stale links" prune_links

################################################################################
# psqlrc sources ~/.psqlrc.local and errors if it is missing
################################################################################
touch_psqlrc_local() {
  if [ -f "$HOME/.psqlrc.local" ]; then
    ui_detail "~/.psqlrc.local exists"
  else
    touch "$HOME/.psqlrc.local" && ui_detail "created ~/.psqlrc.local"
  fi
}
ui_step "psql local config" touch_psqlrc_local

################################################################################
# Enable italics in terminal
################################################################################
install_terminfo() {
  local terminfo="${TMPDIR:-/tmp}/tmux-256color.info"
  /opt/homebrew/opt/ncurses/bin/infocmp tmux-256color >"$terminfo" &&
    tic -xe tmux-256color "$terminfo"
  local status=$?
  rm -f "$terminfo"
  [ $status -eq 0 ] && ui_detail "compiled to ~/.terminfo"
  return $status
}
ui_step "tmux-256color terminfo" install_terminfo

################################################################################
# tmux plugins. TPM reads plugin names from ~/.tmux.conf, so this runs after
# linking. Commits are compared before and after to list what changed.
################################################################################
install_tmux_plugins() {
  local root="$HOME/.tmux/plugins" plugins=() before=() plugin dir after i changed=0 failed=0
  if [ ! -d "$root/tpm" ]; then
    git clone --quiet https://github.com/tmux-plugins/tpm "$root/tpm" || return 1
    ui_item add "tmux-plugins/tpm"
    changed=$((changed + 1))
  fi

  while read -r plugin; do
    plugins+=("$plugin")
    before+=("$(git -C "$root/${plugin##*/}" rev-parse --short HEAD 2>/dev/null)")
  done < <(sed -n -E "s/^[[:space:]]*set(-option)? +-g +@plugin +['\"]([^'\"]+)['\"].*/\2/p" "$HOME/.tmux.conf" |
    grep -v -x 'tmux-plugins/tpm')

  # TPM clones from https://git::@github.com/..., which makes git hand an empty
  # login to the keychain helper on every pull; without a usable keychain that
  # stalls for minutes behind the spinner. The repos are public, so skip helpers.
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= \
    GIT_TERMINAL_PROMPT=0 "$root/tpm/bin/install_plugins"
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= \
    GIT_TERMINAL_PROMPT=0 "$root/tpm/bin/update_plugins" all

  for ((i = 0; i < ${#plugins[@]}; i++)); do
    plugin=${plugins[i]}
    after=$(git -C "$root/${plugin##*/}" rev-parse --short HEAD 2>/dev/null)
    if [ -z "$after" ]; then
      failed=$((failed + 1))
      ui_item fail "$plugin"
    elif [ -z "${before[i]}" ]; then
      changed=$((changed + 1))
      ui_item add "$plugin $after"
    elif [ "$after" != "${before[i]}" ]; then
      changed=$((changed + 1))
      ui_item up "$plugin ${before[i]} → $after"
    else
      ui_verbose && ui_item same "$plugin $after"
    fi
  done

  if [ "$failed" -gt 0 ]; then
    ui_detail "${#plugins[@]} plugins · $failed failed"
    return 1
  elif [ "$changed" -gt 0 ]; then
    ui_detail "${#plugins[@]} plugins · $changed changed"
  else
    ui_detail "${#plugins[@]} plugins · up to date"
  fi
}
ui_step "tmux plugins" install_tmux_plugins

################################################################################
# Custom app icons from icons/. Runs here, not from a LaunchAgent, because only
# the terminal can be granted App Management to write into app bundles.
################################################################################
apply_icons() {
  local out app set=0 failed=0
  out=$("$HOME/dotfiles/bin/refresh-icons" 2>&1) || { echo "$out"; return 1; }
  echo "$out"
  while read -r app; do
    ui_item up "$app"
    set=$((set + 1))
  done < <(sed -n 's/.*Set icon for //p' <<<"$out")
  # Failures are listed but don't fail the step: some apps, like Safari on the
  # sealed system volume, can never be changed.
  while read -r app; do
    ui_item fail "$app"
    failed=$((failed + 1))
  done < <(sed -n 's/.*Failed to set icon for //p' <<<"$out")
  ui_detail "$set set · $failed failed"
}
ui_step "App icons" apply_icons

################################################################################
# Install tool versions with mise. Runs after linking so ~/.tool-versions, the
# mise config and ~/.default-gems exist on a fresh machine.
################################################################################
install_mise_tools() {
  mise install || return 1
  local tool version
  while read -r tool version _; do
    ui_verbose && ui_item same "$tool $version"
  done < <(cd "$HOME" && mise current)
  ui_detail "$(cd "$HOME" && mise current | wc -l | tr -d ' ') tools"
}
ui_step "mise tools" install_mise_tools

################################################################################
# Global NPM packages
################################################################################
GlobalNodeModules=(
  # "bash-language-server"
  # "typescript"
  # "typescript-language-server"
  # "vscode-langservers-extracted"
)
install_npm_globals() {
  local module
  for module in "${GlobalNodeModules[@]}"; do
    npm list -g "$module" >/dev/null 2>&1 || npm install -g "$module" || return 1
  done
  ui_detail "${#GlobalNodeModules[@]} packages"
}
if [ ${#GlobalNodeModules[@]} -eq 0 ]; then
  ui_skip "npm globals" "nothing listed"
else
  ui_step "npm globals" install_npm_globals
fi

################################################################################
# Ruby gems
################################################################################
Gems=(
  # "solargraph"
)
install_gems() {
  local gem
  for gem in "${Gems[@]}"; do
    gem list -i "^$gem$" >/dev/null || gem install "$gem" || return 1
  done
  ui_detail "${#Gems[@]} gems"
}
if [ ${#Gems[@]} -eq 0 ]; then
  ui_skip "Ruby gems" "nothing listed"
else
  ui_step "Ruby gems" install_gems
fi

################################################################################
# Summary of the machine's final state
################################################################################
summarize() {
  local start='' backup='' ok=0 fail=0 skip=0 kind label secs
  if [ -f "$UI_STATE" ]; then
    while IFS='|' read -r kind label secs; do
      case $kind in
        start) start=$label ;;
        backup) backup=$label ;;
        ok) ok=$((ok + 1)) ;;
        fail) fail=$((fail + 1)) ;;
        skip) skip=$((skip + 1)) ;;
      esac
    done <"$UI_STATE"
  fi

  local steps="$ok ok · $fail failed · $skip skipped"
  [ -z "$start" ] && steps="$steps (post-up only)"
  local elapsed=''
  [ -n "$start" ] && elapsed=" in $(ui_duration $(($(date +%s) - start)))"

  local brewfile="$HOME/dotfiles/Brewfile" total missing brew
  total=$(grep -c -E '^(brew|cask) ' "$brewfile")
  missing=$(brew bundle check --verbose --file="$brewfile" 2>/dev/null | grep -c -E '^→ ')
  brew="$((total - missing))/$total Brewfile entries installed"

  # The mise tools step lists each version; here just the count.
  local tools
  total=$(cd "$HOME" && mise ls --current 2>/dev/null | wc -l | tr -d ' ')
  missing=$(cd "$HOME" && mise ls --current --missing 2>/dev/null | wc -l | tr -d ' ')
  tools="$((total - missing))/$total mise tools installed"

  local plugins theme
  plugins=$(grep -c -v -E '^\s*(#|$)' "$HOME/dotfiles/zsh_plugins.txt")
  theme=$(sed -n 's/^ZSH_THEME=//p' "$HOME/dotfiles/zshrc")

  local color=$c_green title="✔ All done$elapsed"
  if [ "$fail" -gt 0 ]; then
    color=$c_red title="✖ Finished with problems$elapsed"
  fi

  local lines=(
    "Steps     $steps"
    "Homebrew  $brew"
    "Tools     $tools"
    "Shell     antidote · $plugins plugins · ${theme:-no theme}"
  )
  [ -n "$backup" ] && lines+=("Backup    ${backup/#$HOME/~}")
  lines+=("Log       ${UI_LOG/#$HOME/~}")

  echo
  ui_box "$color" "$title" "${lines[@]}"
  ui_flags

  # RCUP_RELOAD=1 is set by the rcup wrapper in zshrc, which reloads on success.
  if [ "${RCUP_RELOAD:-0}" = 1 ] && [ "$fail" -eq 0 ]; then
    ui_section "Reloading" "$c_red"
    printf '  %s↻ Reloading your shell…%s %s(for other windows and tmux panes: run the reload command)%s\n\n' \
      "$c_bold$c_cyan" "$c_reset" "$c_dim" "$c_reset"
  else
    ui_section "Reload" "$c_red"
    printf '  %s➜ Run %sreload%s%s to load the new config in this shell%s %s(and other open windows)%s\n\n' \
      "$c_bold$c_yellow" "$c_reset$c_bold" "$c_reset" "$c_bold$c_yellow" "$c_reset" "$c_dim" "$c_reset"
  fi

  rm -f "$UI_STATE"
  [ "$fail" -eq 0 ]
}
summarize

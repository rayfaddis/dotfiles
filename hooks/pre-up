#!/bin/sh

reset -Q

################################################################################
# Tmux package manager
################################################################################
TPMPath="$HOME/.tmux/plugins/tpm"
if [ ! -d "$TPMPath" ]; then
  echo "TPM not found. Installing..."
  git clone https://github.com/tmux-plugins/tpm "$TPMPath"
else
  echo "TPM is already installed."
fi

################################################################################
# Homebrew packages (installs missing and upgrades outdated entries)
################################################################################
brew bundle --file="$HOME/dotfiles/Brewfile"

################################################################################
# LaunchAgents
################################################################################
for Plist in "$HOME"/dotfiles/launchd/*.plist; do
  Label=$(basename "$Plist" .plist)
  echo "Loading LaunchAgent $Label"
  cp "$Plist" "$HOME/Library/LaunchAgents/"
  launchctl bootout "gui/$(id -u)/$Label" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$Label.plist"
done

################################################################################
# Install tool versions with mise (reads ~/.tool-versions)
################################################################################
echo "Installing tool versions with mise"
mise install

################################################################################
# Global NPM packages
################################################################################
GlobalNodeModules=(
  # "npm"
  #
  # "bash-language-server"
  # "typescript"
  # "typescript-language-server"
  # "vscode-langservers-extracted"
)
for NodeModule in "${GlobalNodeModules[@]}"; do
  if [ `npm list -g | grep -c $NodeModule` -eq 0 ]; then
    npm install -g $NodeModule
  fi
done

################################################################################
# Ruby gems
################################################################################
Gems=(
  # "solargraph"
)
for Gem in "${Gems[@]}"; do
  if [ `gem list $Gem | grep -c $Gem` -eq 0 ]; then
    gem install $Gem
  fi
done

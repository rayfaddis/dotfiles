#!/bin/sh

reset -Q

################################################################################
# Tmux package manager
################################################################################
TPMPath="$HOME/.tmux/plugins/tpm"
if [ ! -d "$TPMPath" ]; then
  echo "TPM not found. Installing..."
  git clone https://github.com/tmux-plugins/tpm "$TPMPath"
else
  echo "TPM is already installed."
fi

################################################################################
# Homebrew requirements
################################################################################
HomebrewTaps=(
 # "homebrew/cask-fonts"
)

for Tap in "${HomebrewTaps[@]}"; do
  brew tap $Tap
done

HomebrewFormulas=(
  "antigen"
  "fileicon"
  "golangci-lint"
  "mise"
  "ncurses"
  "neovim"
  "tmux"
  "reattach-to-user-namespace"
  "ripgrep"
  "tree-sitter-cli"
)
for Formula in "${HomebrewFormulas[@]}"; do
  if [ `which $Formula | grep -c "not found"` -eq 0 ]; then
    brew install $Formula
  else
    brew upgrade $Formula
  fi
done

HomebrewCasks=(
  "font-jetbrains-mono-nerd-font"
  "kitty"
)
for Cask in "${HomebrewCasks[@]}"; do
  if [ `which $Cask | grep -c "not found"` -eq 0 ]; then
    brew install --cask $Cask
  else
    brew upgrade --cask $Cask
  fi
done

################################################################################
# LaunchAgents
################################################################################
for Plist in "$HOME"/dotfiles/launchd/*.plist; do
  Label=$(basename "$Plist" .plist)
  echo "Loading LaunchAgent $Label"
  cp "$Plist" "$HOME/Library/LaunchAgents/"
  launchctl bootout "gui/$(id -u)/$Label" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$Label.plist"
done

################################################################################
# Install tool versions with mise (reads ~/.tool-versions)
################################################################################
echo "Installing tool versions with mise"
mise install

################################################################################
# oh-my-zsh completions cache (antigen doesn't create it; the mise plugin needs it)
################################################################################
mkdir -p "$HOME/.antigen/bundles/robbyrussell/oh-my-zsh/cache/completions"

################################################################################
# Global NPM packages
################################################################################
GlobalNodeModules=(
  # "npm"
  #
  # "bash-language-server"
  # "typescript"
  # "typescript-language-server"
  # "vscode-langservers-extracted"
)
for NodeModule in "${GlobalNodeModules[@]}"; do
  if [ `npm list -g | grep -c $NodeModule` -eq 0 ]; then
    npm install -g $NodeModule
  fi
done

################################################################################
# Ruby gems
################################################################################
Gems=(
  # "solargraph"
)
for Gem in "${Gems[@]}"; do
  if [ `gem list $Gem | grep -c $Gem` -eq 0 ]; then
    gem install $Gem
  fi
done

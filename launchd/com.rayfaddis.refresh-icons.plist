<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rayfaddis.refresh-icons</string>

  <!-- The sleep lets an in-progress app update finish replacing its bundle. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>sleep 10; exec "$HOME/dotfiles/bin/refresh-icons" >>"$HOME/Library/Logs/refresh-icons.log" 2>&amp;1</string>
  </array>

  <key>WatchPaths</key>
  <array>
    <string>/Applications</string>
  </array>

  <!-- Fallback for updaters that patch a bundle in place. -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>

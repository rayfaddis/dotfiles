{
  "Rails log": {
    "prefix": "log",
    "body": "Rails.logger.info(\"*** ${1:label} #{${1:variable}}\")",
    "description": "Log variable to the Rails log"
  },
  "Puts": {
    "prefix": "puts",
    "body": "puts(\"*** ${1:label} #{${1:variable}}\")",
    "description": "Output variable to the console"
  },
  "Pry": {
    "prefix": "pry",
    "body": "binding.pry",
    "description": "Insert Pry binding"
  },
  "let inline": {
    "prefix": "letib",
    "body": "let(:$1) { $2 }",
    "description": "RSpec let with inline block"
  },
  "let do": {
    "prefix": "letdb",
    "body": ["let(:$1) do", "  $2", "end"],
    "description": "RSpec let with do block"
  },
  "is_expected inline": {
    "prefix": "itexpectib",
    "body": "it { is_expected.to $1 }",
    "description": "It is expected to, as inline block"
  }
}
